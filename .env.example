# Copy this file to .env.local for local-only configuration.
# Never commit .env.local or any real credentials.

# Supabase project URL for the environment being developed.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anonymous key for the environment being developed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key. Keep this out of client code and source control.
SUPABASE_SERVICE_ROLE_KEY=
