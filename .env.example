# Copy this file to .env.local for local-only configuration.
# Never commit .env.local or any real credentials.

# Public site origin used by metadata and Open Graph URLs.
# Set the stable staging alias in Vercel Preview and https://ocsco.io in Production.
# Local development may leave this blank.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL for the environment being developed.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key for browser-safe client operations.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Keep this out of client code and source control.
SUPABASE_SECRET_KEY=

# Server-only Resend notification configuration.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_EMAIL=ocscolabs@gmail.com
INQUIRY_NOTIFICATION_FROM=OCSCO inquiries <onboarding@resend.dev>

# Set to true only for an environment intended to receive real inquiries.
# Production is enabled automatically; Preview is disabled by default.
INQUIRY_SUBMISSIONS_ENABLED=false
